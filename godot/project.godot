; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Plateau Map"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
run/main_scene.packed="res://scenes/boot.tscn"

[autoload]

Settings="*res://scripts/settings.gd"
AutoUpdater="*res://scripts/updater.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/plateau_builder/plugin.cfg")

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="buildings"
3d_physics/layer_3="boundary"
3d_physics/layer_4="player"
3d_physics/layer_5="vegetation"
3d_physics/layer_6="props"
3d_physics/layer_7="vehicles"
3d_physics/layer_8="vehicle_inside"
3d_physics/layer_9="breakable"
3d_physics/layer_10="debris"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
rendering_device/driver.windows="vulkan"

[shader_globals]

signal_clock={
"type": "float",
"value": 0.0
}
night={
"type": "float",
"value": 0.0
}
